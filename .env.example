# Copy to .env.local (git-ignored) and fill in from Supabase: Project Settings → API Keys / Data API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_…). Older dashboards call it the "anon" key. Never put the secret/service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
